<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>9.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableDefaultItems>false</EnableDefaultItems>
        <DefineConstants>$(DefineConstants);ECS_BENCHMARK_FORCE_INLINING</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <NpmPackageFile Include="package.json"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="node_modules\ecs.benchmark.staticecs\Runtime\Benchmark.StaticEcs\**\*.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Benchmark.Core\Benchmark.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="FFS.StaticEcs" Version="2.0.3"/>
    </ItemGroup>

</Project>
